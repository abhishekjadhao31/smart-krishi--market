{
  "name": "smart-krishi-market-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Smart Krishi Market — AI-powered agriculture marketplace",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/utils/migrate.js",
    "migrate:matching": "node src/utils/migrateMatching.js",
    "seed:prices": "node seeds/seedMarketPrices.js",
    "seed:logistics": "node seeds/seed_logistics.js",
    "mandi:fetch": "python ../scripts/mandi/fetch_mandi_data.py",
    "mandi:clean": "python ../scripts/mandi/clean_mandi_data.py",
    "mandi:seed": "python ../scripts/mandi/seed_market_prices.py"
  },
  "keywords": [
    "agriculture",
    "marketplace",
    "express",
    "postgresql",
    "jwt"
  ],
  "author": "Smart Krishi Market Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.7.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "geolib": "^3.3.14",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.12.0",
    "prisma": "^7.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
